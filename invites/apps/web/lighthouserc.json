{
  "ci": {
    "collect": { "url": ["http://localhost:3000/", "http://localhost:3000/demo/riyaFRND2", "http://localhost:3000/pricing"], "numberOfRuns": 2, "settings": { "preset": "mobile", "throttlingMethod": "simulate" } },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-byte-weight": ["warn", { "maxNumericValue": 1400000 }]
      }
    }
  }
}
