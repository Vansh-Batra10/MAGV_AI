# Hilo — every variable is optional. Anything missing runs in MOCK mode automatically.
# Copy to .env.local and fill in what you have. See docs/SETUP.md.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_RELEASE=1                 # 1 | 2 | 3 — which release's templates/pages are live
AUTH_SECRET=                          # 32+ random chars (sessions, upload tokens, gift password cookies). REQUIRED in production.
ADMIN_EMAILS=admin@hilo.example       # comma-separated; these emails can open /admin
CRON_SECRET=                          # Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
HILO_DATA_DIR=                        # MOCK mode: PGlite DB + uploads. Default node_modules/.cache/hilo-data (must be outside the watched tree)
HILO_OPEN_TOOLS=                       # 1 = open studio/outbox + test clock without admin login. E2E only, NEVER in production.
HILO_FAKE_NOW=                        # optional ISO date to time-travel the server clock (testing)

# --- Database (Postgres / Supabase). Missing → PGlite at $HILO_DATA_DIR/pglite ---
DATABASE_URL=                         # e.g. Supabase "Session pooler" connection string

# --- Storage (Supabase Storage). Missing → local disk at $HILO_DATA_DIR/uploads ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=gift-media

# --- Payments (Razorpay). Missing → branded mock checkout with "Simulate success/failure" ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
HILO_MOR_PROVIDER=                    # reserved: Merchant-of-Record slot for the Global edition (not implemented in v1)

# --- Messaging. Missing → messages land in the outbox (/admin/outbox) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
RESEND_API_KEY=
EMAIL_FROM="Hilo <hello@hilo.example>"

# --- AI (Love Letter + auto-fill). Missing → well-written canned drafts ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Rate limiting (optional; in-memory otherwise) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Analytics (load ONLY after cookie consent) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
