# Copy to .env (make setup does this). Never commit .env.

# dev | test | demo | production
APP_ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./var/receptionist.db
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console
# Salt for hashing phone numbers/emails in logs. Required (non-default) in production.
LOG_HASH_SALT=change-me

# Demo clock override. Only allowed with APP_ENV=demo; the app refuses to start otherwise.
# Naive values are local time in each tenant's timezone, e.g. Saturday 2:10 PM:
# DEMO_NOW=2026-10-03T14:10
# ticking (advances in real time) | frozen
DEMO_CLOCK_MODE=ticking

# Models (DESIGN.md section 5)
# Either name works; use RECEPTIONIST_ANTHROPIC_API_KEY in Claude Code cloud environments,
# which reserve ANTHROPIC_API_KEY for their own login.
ANTHROPIC_API_KEY=
MODEL_LIVE=claude-haiku-4-5
MODEL_SUMMARY=claude-sonnet-5-5
MODEL_JUDGE=claude-opus-5-5
MODEL_CALLER_SIM=claude-sonnet-5-5

# Demo inboxes referenced by tenant configs (notifications.owner_email_env, on_call.email_env)
DEMO_OWNER_EMAIL=
DEMO_ONCALL_EMAIL=

# Cal.com, demo owner's account (Phase 3)
CALCOM_DEMO_API_KEY=
CALCOM_DEMO_EVENT_TYPE_ID=
# Placeholder attendee email when Cal.com requires one and the caller gave none.
# {session_short} is the only field, e.g. myname+jb-{session_short}@gmail.com
PLACEHOLDER_EMAIL_TEMPLATE=

# Retell (Phase 5)
RETELL_API_KEY=
RETELL_AGENT_ID_JOLLY=
RETELL_WS_TOKEN_JOLLY=

# SMTP (Phase 6)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
